# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Get this from @BotFather on Telegram. Never commit the real token.
BOT_TOKEN=123456789:replace-me

# polling | webhook
MODE=polling

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
DB_PATH=data/bot.db
ADMIN_CACHE_TTL=300

# ---------------------------------------------------------------------------
# Moderation defaults (can be overridden per chat with /settings)
# ---------------------------------------------------------------------------
# delete | warn | mute | ban
DEFAULT_ACTION=delete
WARN_LIMIT=3
MUTE_SECONDS=600
VIOLATION_DECAY_SECONDS=86400

# ---------------------------------------------------------------------------
# Anti-flood
# ---------------------------------------------------------------------------
FLOOD_MAX_MESSAGES=5
FLOOD_WINDOW_SECONDS=10

# ---------------------------------------------------------------------------
# Captcha for new members
# ---------------------------------------------------------------------------
CAPTCHA_ENABLED=false
CAPTCHA_TIMEOUT=120
CAPTCHA_KICK_ON_TIMEOUT=true

# ---------------------------------------------------------------------------
# Optional audit channel (numeric chat id, e.g. -1001234567890)
# ---------------------------------------------------------------------------
# AUDIT_CHAT_ID=-1001234567890

# ---------------------------------------------------------------------------
# Webhook settings (only used when MODE=webhook)
# ---------------------------------------------------------------------------
# Public URL port: 443 (default if omitted), 80, 88 or 8443 only
# WEBHOOK_URL=https://bot.example.com/telegram
# WEBHOOK_DOMAIN=bot.example.com
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_PORT=8443
# WEBHOOK_PATH=/telegram
# Required: 32-256 characters; ASCII letters, digits, underscores and hyphens only
# WEBHOOK_SECRET=replace-with-32-or-more-random-characters
# Optional: use TLS managed by the bot itself instead of a reverse proxy
# WEBHOOK_CERT=/path/to/fullchain.pem
# WEBHOOK_KEY=/path/to/privkey.pem
